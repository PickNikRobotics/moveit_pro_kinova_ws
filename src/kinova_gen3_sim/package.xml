<?xml version="1.0" ?>
<package format="3">
  <name>kinova_gen3_sim</name>
  <version>10.0.0</version>

  <description>
    MuJoCo-simulation configuration for a Kinova Gen3 7DoF arm. Inherits the
    URDF, SRDF, and MoveIt configuration from kinova_gen3_mock and selects the
    MuJoCo ros2_control hardware with its own scene.
  </description>

  <maintainer email="paul.gesel@picknik.ai">Paul Gesel</maintainer>
  <maintainer email="david.yackzan@picknik.ai">David Yackzan</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>kinova_gen3_mock</depend>

  <exec_depend>picknik_mujoco_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
