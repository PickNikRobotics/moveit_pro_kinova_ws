<mujoco model="kinova_gen3 scene">
  <!--
    Kinova Gen3 7DoF on a table, matching kinova_gen3_mock's URDF: base_link at
    the world origin and a 2.0 x 2.0 x 0.25 m table whose top sits 0.045 m below it.
  -->
  <include file="gen3_7dof.xml" />

  <statistic center="0.3 0 0.4" extent="1" />

  <default>
    <geom solref=".004 1" />
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
  </visual>

  <asset>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"
    />
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"
    />
    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"
    />
    <material name="table" rgba="0.8 0.8 0.8 0.3" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <geom
      name="floor"
      pos="0 0 -0.295"
      size="0 0 0.05"
      type="plane"
      material="groundplane"
    />
    <geom
      name="table"
      type="box"
      pos="0 0 -0.17"
      size="1.0 1.0 0.125"
      material="table"
    />
    <camera
      name="scene_camera"
      pos="0.0 0.3 0.55"
      fovy="58"
      mode="fixed"
      resolution="640 480"
      quat="0.365715 0.232986 -0.484157 -0.759975"
    />
    <site
      name="scene_camera_optical_frame"
      pos="0.0 0.3 0.55"
      quat="0.365715 0.232986 -0.484157 -0.759975"
    />
  </worldbody>

  <!-- Matches kinova_gen3_mock/config/initial_positions.yaml. -->
  <keyframe>
    <key
      name="default"
      qpos="0 0 -3.14 -2.51 0 0.96 1.57"
      ctrl="0 0 -3.14 -2.51 0 0.96 1.57"
    />
  </keyframe>
</mujoco>
