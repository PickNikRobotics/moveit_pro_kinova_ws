<?xml version="1.0"?>
<robot name="gen3" xmlns:xacro="http://ros.org/wiki/xacro">
    <!-- Arguments for Kinova -->
    <xacro:arg name="arm" default="gen3" />
    <xacro:arg name="dof" default="7" />
    <xacro:arg name="vision" default="true" />
    <xacro:arg name="robot_ip" default="yyy.yyy.yyy.yyy" />
    <xacro:arg name="username" default="admin" />
    <xacro:arg name="password" default="admin" />
    <xacro:arg name="port" default="10000" />
    <xacro:arg name="port_realtime" default="10001" />
    <xacro:arg name="session_inactivity_timeout_ms" default="60000" />
    <xacro:arg name="connection_inactivity_timeout_ms" default="2000" />
    <xacro:arg name="prefix" default="" />
    <!-- Which <ros2_control> hardware the arm uses:
           mock      ros2_control mock hardware (mock_components/GenericSystem)
           mujoco    MuJoCo simulation (picknik_mujoco_ros/MujocoSystem)
           physical  the real arm over the Kortex driver -->
    <xacro:arg name="hardware_interface" default="mock" />
    <xacro:property name="hardware_interface" value="$(arg hardware_interface)" />
    <xacro:arg name="fake_sensor_commands" default="false" />
    <xacro:arg name="isaac_joint_commands" default="/isaac_joint_commands" />
    <xacro:arg name="isaac_joint_states" default="/isaac_joint_states" />
    <xacro:arg name="use_external_cable" default="false" />
    <!-- Gripper selection, forwarded to ros2_kortex's load_arm. The boilerplate
         mounts no gripper, so these default to empty and tool_frame stays at the
         wrist flange.

         WARNING: setting these alone does NOT mount a gripper. load_arm uses them
         for the Kortex hardware block and to add the gripper joint to
         <ros2_control>, but contributes no links and no kinematic joint, so a
         config that sets only these produces a model whose <ros2_control> block
         references a joint the kinematic model does not contain. A complete
         gripper overlay also needs a gripper description include, a gripper
         controller in the ros2_control manifest, and a gripper group in the SRDF.
         See "Adding a Robotiq gripper" in the workspace README, and the
         picknik_006_gen3 branch for a reference implementation. -->
    <xacro:arg name="gripper" default="" />
    <xacro:arg name="gripper_joint_name" default="" />
    <xacro:arg name="use_internal_bus_gripper_comm" default="false" />
    <!-- MuJoCo args, used only when hardware_interface is mujoco. The config that
         selects MuJoCo (kinova_gen3_sim) names its own scene package and file. -->
    <xacro:arg name="mujoco_model" default="" />
    <xacro:arg name="mujoco_model_package" default="" />
    <xacro:arg name="mujoco_keyframe" default="" />
    <xacro:arg name="mujoco_viewer" default="false" />

    <!-- Import macros for main hardware components -->
    <xacro:include filename="$(find kinova_gen3_mock)/description/kortex_robot.xacro" />

    <!-- Import environment macros -->
    <xacro:include filename="$(find picknik_accessories)/descriptions/geometry/cube.urdf.xacro"/>

    <!-- World is centered under base_link of the robot, on the ground -->
    <link name="world"/>

    <!-- initial position for simulations (Mock Hardware, Gazebo, Ignition) -->
    <xacro:arg name="initial_positions_file" default="$(find kinova_gen3_mock)/config/initial_positions.yaml"/>
    <!-- convert to property to use substitution in function -->
    <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

    <!-- ros2_control hardware for the selected hardware_interface. load_robot
         below is called with include_ros2_control="false", so this is the only
         <ros2_control> block for the arm. -->
    <xacro:if value="${hardware_interface in ['mock', 'physical']}">
      <xacro:include filename="$(find kortex_description)/arms/$(arg arm)/$(arg dof)dof/urdf/kortex.ros2_control.xacro" />
      <xacro:kortex_ros2_control
        name="$(arg prefix)KortexMultiInterfaceHardware" prefix="$(arg prefix)"
        use_fake_hardware="${hardware_interface == 'mock'}"
        fake_sensor_commands="$(arg fake_sensor_commands)"
        sim_gazebo="false"
        sim_isaac="false"
        isaac_joint_commands="$(arg isaac_joint_commands)"
        isaac_joint_states="$(arg isaac_joint_states)"
        tf_prefix=""
        initial_positions="${xacro.load_yaml(initial_positions_file)}"
        robot_ip="$(arg robot_ip)"
        username="$(arg username)"
        password="$(arg password)"
        port="$(arg port)"
        port_realtime="$(arg port_realtime)"
        session_inactivity_timeout_ms="$(arg session_inactivity_timeout_ms)"
        connection_inactivity_timeout_ms="$(arg connection_inactivity_timeout_ms)"
        use_internal_bus_gripper_comm="$(arg use_internal_bus_gripper_comm)"
        gripper_max_velocity="100.0"
        gripper_max_force="100.0"
        gripper_joint_name="$(arg gripper_joint_name)"
        gripper="$(arg gripper)"/>
    </xacro:if>
    <xacro:if value="${hardware_interface == 'mujoco'}">
      <xacro:include filename="$(find kinova_gen3_mock)/description/kinova_gen3_mujoco.ros2_control.xacro" />
      <xacro:kinova_gen3_mujoco_ros2_control
        name="$(arg prefix)KinovaGen3MujocoSystem"
        mujoco_model="$(arg mujoco_model)"
        mujoco_model_package="$(arg mujoco_model_package)"
        mujoco_keyframe="$(arg mujoco_keyframe)"
        mujoco_viewer="$(arg mujoco_viewer)"/>
    </xacro:if>
    <xacro:unless value="${hardware_interface in ['mock', 'mujoco', 'physical']}">
      <xacro:element xacro:name="${xacro.fatal('hardware_interface must be mock, mujoco, or physical, not ' + hardware_interface)}"/>
    </xacro:unless>

    <!-- Load the robot. No gripper is mounted by default; the Kinova-integrated
         wrist Vision Module is enabled via vision="true". -->
    <xacro:load_robot
      parent="world"
      prefix="$(arg prefix)"
      arm="$(arg arm)"
      gripper="$(arg gripper)"
      gripper_joint_name="$(arg gripper_joint_name)"
      dof="$(arg dof)"
      vision="$(arg vision)"
      robot_ip="$(arg robot_ip)"
      username="$(arg username)"
      password="$(arg password)"
      port="$(arg port)"
      port_realtime="$(arg port_realtime)"
      session_inactivity_timeout_ms="$(arg session_inactivity_timeout_ms)"
      connection_inactivity_timeout_ms="$(arg connection_inactivity_timeout_ms)"
      use_internal_bus_gripper_comm="$(arg use_internal_bus_gripper_comm)"
      use_external_cable="$(arg use_external_cable)"
      initial_positions="${xacro.load_yaml(initial_positions_file)}"
      include_ros2_control="false" >
      <origin xyz="0 0 0.0" rpy="0 0 0" />
    </xacro:load_robot>

    <!-- Environment -->
    <!-- The table top must stay clear of base_link by more than the collision
         padding applied to both, or a fresh checkout reports "start state in
         collision" with no obvious cause. At z = -0.17 the 0.25 m cube's top sits
         at -0.045, leaving 4.5 cm against a default link_padding of 0.01. -->
    <xacro:cube link_name="table" connected_to="world" length="2.00" width="2.00" height="0.25" alpha="0.3">
      <origin xyz="0 0 -0.17" rpy="0 0 0"/>
    </xacro:cube>

    <!-- Convenience alias for motion-planning-relevant tool point. The
         kortex_robot macro defines $(prefix)tool_frame at the wrist when no
         gripper is mounted; we expose it as grasp_link so existing config files
         (control, jtac, etc.) keep working when a gripper is added later. -->
    <link name="$(arg prefix)grasp_link"/>
    <joint name="$(arg prefix)grasp_link_joint" type="fixed">
      <parent link="$(arg prefix)tool_frame"/>
      <child link="$(arg prefix)grasp_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>
