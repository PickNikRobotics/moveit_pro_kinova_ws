<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="load_robot" params="
    parent
    *origin
    prefix:=''
    vision:=true
    hardware_interface:=mock
    fake_sensor_commands:=false
    mujoco_model:=description/mujoco/scene.xml
    mujoco_model_package:=kinova_gen3_sim
    mujoco_viewer:=false
    mujoco_keyframe:=default
    initial_positions:=${dict(joint_1=0.0,joint_2=0.0,joint_3=0.0,joint_4=0.0,joint_5=0.0,joint_6=0.0,joint_7=0.0)}
    robot_ip:=192.168.1.10
    username:=admin
    password:=admin
    port:=10000
    port_realtime:=10001
    session_inactivity_timeout_ms:=60000
    connection_inactivity_timeout_ms:=2000
    tf_prefix:=''
    use_internal_bus_gripper_comm:=false
    gripper:=robotiq_2f_85
    gripper_joint_name:=robotiq_85_left_knuckle_joint
    gripper_max_velocity:=100.0
    gripper_max_force:=100.0">

    <!-- Include and load arm macro files -->
    <xacro:include filename="$(find kinova_gen3_mock)/description/arms/gen3/7dof/urdf/gen3_macro.xacro" />

    <!-- Load the arm -->
    <xacro:load_arm
      parent="${parent}"
      vision="${vision}"
      prefix="${prefix}"
      hardware_interface="${hardware_interface}"
      fake_sensor_commands="${fake_sensor_commands}"
      mujoco_model="${mujoco_model}"
      mujoco_model_package="${mujoco_model_package}"
      mujoco_viewer="${mujoco_viewer}"
      mujoco_keyframe="${mujoco_keyframe}"
      initial_positions="${initial_positions}"
      robot_ip="${robot_ip}"
      username="${username}"
      password="${password}"
      port="${port}"
      port_realtime="${port_realtime}"
      session_inactivity_timeout_ms="${session_inactivity_timeout_ms}"
      connection_inactivity_timeout_ms="${connection_inactivity_timeout_ms}"
      tf_prefix="${tf_prefix}"
      use_internal_bus_gripper_comm="${use_internal_bus_gripper_comm}"
      gripper="${gripper}"
      gripper_joint_name="${gripper_joint_name}"
      gripper_max_velocity="${gripper_max_velocity}"
      gripper_max_force="${gripper_max_force}">
      <xacro:insert_block name="origin" />
    </xacro:load_arm>

    <!-- Include and load the gripper -->
    <xacro:include filename="$(find kinova_gen3_mock)/description/grippers/robotiq_2f_85/urdf/robotiq_2f_85_macro.xacro" />
    <xacro:load_gripper
      parent="${prefix}${last_arm_link}"
      prefix="${prefix}"
      hardware_interface="${hardware_interface}"
      use_internal_bus_gripper_comm="${use_internal_bus_gripper_comm}"
      fake_sensor_commands="${fake_sensor_commands}"/>

  </xacro:macro>

</robot>
