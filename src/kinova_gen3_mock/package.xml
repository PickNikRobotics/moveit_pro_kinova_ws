<?xml version="1.0" ?>
<package format="3">
  <name>kinova_gen3_mock</name>
  <version>10.0.0</version>

  <description>
    Mock-hardware boilerplate configuration for a Kinova Gen3 7DoF arm with the
    integrated wrist Vision Module. No gripper or external sensors are mounted.
  </description>

  <maintainer email="david.yackzan@picknik.ai">David Yackzan</maintainer>
  <maintainer email="paul.gesel@picknik.ai">Paul Gesel</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>kinova_pstop_manager</depend>
  <depend>kortex_description</depend>

  <exec_depend>joint_trajectory_admittance_controller</exec_depend>
  <exec_depend>joint_velocity_controller</exec_depend>
  <exec_depend>moveit_ros_perception</exec_depend>
  <exec_depend>moveit_studio_agent</exec_depend>
  <exec_depend>moveit_pro_behavior</exec_depend>
  <exec_depend>picknik_accessories</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>velocity_force_controller</exec_depend>

  <test_depend>ament_lint_auto</test_depend>

  <test_depend>ament_clang_format</test_depend>
  <test_depend>ament_clang_tidy</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>picknik_ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ros2bag</test_depend>
  <test_depend>rosbag2_storage_default_plugins</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>moveit_studio_utils_py</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
