<?xml version="1.0" ?>
<package format="3">
  <name>picknik_006_gen3_hw</name>
  <version>5.1.0</version>

  <description>
    Hardware configuration for the picknik_006_gen3 asset — Kinova Gen3 7DoF +
    Robotiq 2F-85 (Kinova internal bus) + wrist-mounted RealSense D415, on the
    real Kortex driver. Inherits from picknik_006_gen3_sim.
  </description>

  <maintainer email="david.yackzan@picknik.ai">David Yackzan</maintainer>
  <maintainer email="paul.gesel@picknik.ai">Paul Gesel</maintainer>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>picknik_006_gen3_sim</depend>

  <exec_depend>kinova_pstop_manager</exec_depend>
  <exec_depend>kinova_vision</exec_depend>
  <exec_depend>kortex_driver</exec_depend>
  <exec_depend>picknik_reset_fault_controller</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ros_tcp_endpoint</exec_depend>

  <test_depend>ament_lint_auto</test_depend>

  <test_depend>ament_clang_format</test_depend>
  <test_depend>ament_clang_tidy</test_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>picknik_ament_copyright</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
